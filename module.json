{
  "id": "smit-shah/airtable",
  "slug": "smit-shah/airtable",
  "name": "Airtable",
  "version": "1.0.1",
  "description": "Production-grade integration with Airtable REST API. Manage records, execute batch CRUD/upserts, inspect and mutate schemas, collaborate via comments, and discover bases. contest:round2 contest:2026Q3",
  "auth": {
    "type": "api_key",
    "env_var": "AIRTABLE_PAT"
  },
  "requires": {
    "network": [
      "api.airtable.com"
    ],
    "subprocess": false,
    "filesystem_writes": []
  },
  "license_required": false,
  "commands": [
    {
      "name": "create_record",
      "description": "Add a new record to the specified Airtable table. Requires airlock approval.",
      "side_effects": "external",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table in the base"
          },
          "fields": {
            "type": "object",
            "description": "Key-value mapping of field names to values for the new record"
          },
          "typecast": {
            "type": "boolean",
            "description": "Perform best-effort automatic data conversion (e.g. string to choice)"
          }
        },
        "required": [
          "base_id",
          "table_name",
          "fields"
        ]
      },
      "id": "create_record",
      "title": "Create Record"
    },
    {
      "name": "update_record",
      "description": "Update fields on an existing record in an Airtable table (PATCH). Requires airlock approval.",
      "side_effects": "external",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table"
          },
          "record_id": {
            "type": "string",
            "description": "The Airtable record ID to update (e.g. recXXXXXXXXXXXXXX)"
          },
          "fields": {
            "type": "object",
            "description": "Key-value mapping of field names to update"
          },
          "typecast": {
            "type": "boolean",
            "description": "Perform best-effort automatic data conversion"
          }
        },
        "required": [
          "base_id",
          "table_name",
          "record_id",
          "fields"
        ]
      },
      "id": "update_record",
      "title": "Update Record"
    },
    {
      "name": "delete_record",
      "description": "Permanently delete a record from an Airtable table. Requires airlock approval.",
      "side_effects": "external",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table"
          },
          "record_id": {
            "type": "string",
            "description": "The Airtable record ID to delete (e.g. recXXXXXXXXXXXXXX)"
          }
        },
        "required": [
          "base_id",
          "table_name",
          "record_id"
        ]
      },
      "id": "delete_record",
      "title": "Delete Record"
    },
    {
      "name": "get_record",
      "description": "Retrieve a single record by its record ID from an Airtable table.",
      "side_effects": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table"
          },
          "record_id": {
            "type": "string",
            "description": "The Airtable record ID to retrieve (e.g. recXXXXXXXXXXXXXX)"
          }
        },
        "required": [
          "base_id",
          "table_name",
          "record_id"
        ]
      },
      "id": "get_record",
      "title": "Get Record"
    },
    {
      "name": "list_records",
      "description": "List records from an Airtable table with optional filtering, sorting, view restrictions, and pagination.",
      "side_effects": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table"
          },
          "max_records": {
            "type": "integer",
            "description": "Total maximum number of records to return (defaults to 100, max 1000)"
          },
          "page_size": {
            "type": "integer",
            "description": "Number of records per page (max 100)"
          },
          "offset": {
            "type": "string",
            "description": "Pagination cursor token returned by a previous list call"
          },
          "view": {
            "type": "string",
            "description": "Name or ID of a view in the table to limit results to"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Subset of field names to include in each returned record"
          },
          "sort": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ]
                }
              },
              "required": [
                "field"
              ]
            },
            "description": "List of sort objects, e.g. [{'field': 'Name', 'direction': 'asc'}]"
          }
        },
        "required": [
          "base_id",
          "table_name"
        ]
      },
      "id": "list_records",
      "title": "List Records"
    },
    {
      "name": "search_records",
      "description": "Filter records in an Airtable table using a formula expression (e.g. {Status}='Done').",
      "side_effects": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table"
          },
          "filter_by_formula": {
            "type": "string",
            "description": "Airtable formula string to evaluate against each record"
          },
          "max_records": {
            "type": "integer",
            "description": "Maximum number of matching records to return (default 100)"
          }
        },
        "required": [
          "base_id",
          "table_name",
          "filter_by_formula"
        ]
      },
      "id": "search_records",
      "title": "Search Records"
    },
    {
      "name": "list_tables",
      "description": "List all tables and field schema definitions in a given Airtable base.",
      "side_effects": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          }
        },
        "required": [
          "base_id"
        ]
      },
      "id": "list_tables",
      "title": "List Tables"
    },
    {
      "name": "batch_create_records",
      "description": "Create up to 10 records in a single batch request in an Airtable table. Requires airlock approval.",
      "side_effects": "external",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "object",
                  "description": "Key-value mapping of field names to values"
                }
              },
              "required": [
                "fields"
              ]
            },
            "description": "Array of up to 10 record objects to create"
          },
          "typecast": {
            "type": "boolean",
            "description": "Perform best-effort automatic data conversion"
          }
        },
        "required": [
          "base_id",
          "table_name",
          "records"
        ]
      },
      "id": "batch_create_records",
      "title": "Batch Create Records"
    },
    {
      "name": "batch_update_records",
      "description": "Update up to 10 records in a single batch request (PATCH). Requires airlock approval.",
      "side_effects": "external",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Record ID to update (e.g. recXXXXXXXXXXXXXX)"
                },
                "fields": {
                  "type": "object",
                  "description": "Key-value mapping of fields to update"
                }
              },
              "required": [
                "id",
                "fields"
              ]
            },
            "description": "Array of up to 10 record objects with id and fields"
          },
          "typecast": {
            "type": "boolean",
            "description": "Perform best-effort automatic data conversion"
          }
        },
        "required": [
          "base_id",
          "table_name",
          "records"
        ]
      },
      "id": "batch_update_records",
      "title": "Batch Update Records"
    },
    {
      "name": "batch_delete_records",
      "description": "Delete up to 10 records in a single batch request. Requires airlock approval.",
      "side_effects": "external",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table"
          },
          "record_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of up to 10 Airtable record IDs to delete"
          }
        },
        "required": [
          "base_id",
          "table_name",
          "record_ids"
        ]
      },
      "id": "batch_delete_records",
      "title": "Batch Delete Records"
    },
    {
      "name": "batch_upsert_records",
      "description": "Insert or update up to 10 records matching on key fields (upsert). Requires airlock approval.",
      "side_effects": "external",
      "input_schema": {
        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table"
          },
          "fields_to_merge_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Field names used to determine whether a record already exists"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "object",
                  "description": "Key-value mapping of field names to values"
                }
              },
              "required": [
                "fields"
              ]
            },
            "description": "Array of up to 10 record objects to upsert"
          },
          "typecast": {
            "type": "boolean",
            "description": "Perform best-effort automatic data conversion"
          }
        },
        "required": [
          "base_id",
          "table_name",
          "fields_to_merge_on",
          "records"
        ]
      },
      "id": "batch_upsert_records",
      "title": "Batch Upsert Records"
    },
    {
      "name": "list_bases",
