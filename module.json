        "type": "object",
        "properties": {
          "base_id": {
            "type": "string",
            "description": "The Airtable Base ID (e.g. appXXXXXXXXXXXXXX)"
          },
          "table_name": {
            "type": "string",
            "description": "The name or ID of the table"
          },
          "record_id": {
            "type": "string",
            "description": "The record ID to inspect (e.g. recXXXXXXXXXXXXXX)"
